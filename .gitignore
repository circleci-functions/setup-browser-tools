# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, HTML coverage reports
*.out
coverage.html

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Project-specific
# Anchored so they cannot swallow a testdata/dist or testdata/.task fixture.
/dist/
/.task/

# Binary left by `go build ./...` in the module root.
/setup-browser-tools
